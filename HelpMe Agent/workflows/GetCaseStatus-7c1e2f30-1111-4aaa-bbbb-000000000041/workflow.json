                    0
                  ]
                },
                "actions": {
                  "Set_header": {
                    "type": "SetVariable",
                    "runAfter": {},
                    "inputs": {
                      "name": "resultText",
                      "value": "\u0E40\u0E04\u0E2A\u0E17\u0E35\u0E48\u0E01\u0E33\u0E25\u0E31\u0E07\u0E14\u0E33\u0E40\u0E19\u0E34\u0E19\u0E01\u0E32\u0E23\u0E02\u0E2D\u0E07\u0E17\u0E48\u0E32\u0E19:"
                    }
                  },
                  "For_each_mine": {
                    "type": "Foreach",
                    "runAfter": {
                      "Set_header": [
                        "Succeeded"
                      ]
                    },
                    "foreach": "@outputs(\u0027Get_Mine\u0027)?[\u0027body/value\u0027]",
                    "actions": {
                      "Append_line": {
                        "type": "AppendToStringVariable",
                        "inputs": {
                          "name": "resultText",
                          "value": "@concat(\u0027\n\u2022 \u0027, item()?[\u0027CaseID\u0027], \u0027 - \u0027, coalesce(item()?[\u0027SystemName\u0027],\u0027-\u0027), \u0027 - \u0027, if(equals(item()?[\u0027Statuscase\u0027]?[\u0027Value\u0027],\u0027In Progress\u0027),\u0027\u0E01\u0E33\u0E25\u0E31\u0E07\u0E14\u0E33\u0E40\u0E19\u0E34\u0E19\u0E01\u0E32\u0E23\u0027,if(equals(item()?[\u0027Statuscase\u0027]?[\u0027Value\u0027],\u0027Resolved\u0027),\u0027\u0E41\u0E01\u0E49\u0E44\u0E02\u0E40\u0E2A\u0E23\u0E47\u0E08\u0E41\u0E25\u0E49\u0E27 (\u0E23\u0E2D\u0E22\u0E37\u0E19\u0E22\u0E31\u0E19)\u0027,if(equals(item()?[\u0027Statuscase\u0027]?[\u0027Value\u0027],\u0027Reopened\u0027),\u0027\u0E40\u0E1B\u0E34\u0E14\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E43\u0E2B\u0E21\u0E48\u0027,if(equals(item()?[\u0027Statuscase\u0027]?[\u0027Value\u0027],\u0027On Hold\u0027),\u0027\u0E1E\u0E31\u0E01\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E0A\u0E31\u0E48\u0E27\u0E04\u0E23\u0E32\u0E27\u0027,coalesce(item()?[\u0027Statuscase\u0027]?[\u0027Value\u0027],\u0027-\u0027))))))"
                        }
                      }
                    }
                  }
                },
                "else": {
                  "actions": {
                    "Set_none": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "resultText",
                        "value": "\u0E17\u0E48\u0E32\u0E19\u0E44\u0E21\u0E48\u0E21\u0E35\u0E40\u0E04\u0E2A\u0E17\u0E35\u0E48\u0E01\u0E33\u0E25\u0E31\u0E07\u0E14\u0E33\u0E40\u0E19\u0E34\u0E19\u0E01\u0E32\u0E23\u0E2D\u0E22\u0E39\u0E48\u0E43\u0E19\u0E02\u0E13\u0E30\u0E19\u0E35\u0E49\u0E04\u0E23\u0E31\u0E1A"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "Response": {
          "type": "Response",
          "kind": "Skills",
          "runAfter": {
            "Condition_HasCaseId": [
