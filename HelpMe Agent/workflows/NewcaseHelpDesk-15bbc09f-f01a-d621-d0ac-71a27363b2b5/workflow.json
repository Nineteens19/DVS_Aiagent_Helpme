                    },
                    "runAfter": {
                      "Get_Routing_Helpdesk": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Set_MailCC_Helpdesk": {
                    "type": "SetVariable",
                    "inputs": {
                      "name": "MailCC",
                      "value": "@coalesce(first(outputs(\u0027Get_Routing_Helpdesk\u0027)?[\u0027body/value\u0027])?[\u0027CCNotify\u0027],\u0027\u0027)"
                    },
                    "runAfter": {
                      "Set_MailTo_Helpdesk": [
                        "Succeeded"
                      ]
                    }
                  }
                }
              },
              "runAfter": {
                "Get_Routing_bySystem": [
                  "Succeeded"
                ]
              }
            },
            "Set_MailToFinal": {
              "type": "SetVariable",
