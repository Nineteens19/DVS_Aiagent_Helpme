                  "id": "@outputs(\u0027Create_item_Cases\u0027)?[\u0027body/ID\u0027]",
                  "item/AssignedOwner": "@variables(\u0027MailToFinal\u0027)",
                  "item/SlaDueDate": "@if(greater(length(outputs(\u0027Get_SLA_bySeverity\u0027)?[\u0027body/value\u0027]),0), addHours(utcNow(), int(coalesce(first(outputs(\u0027Get_SLA_bySeverity\u0027)?[\u0027body/value\u0027])?[\u0027ResolutionHours\u0027],\u002748\u0027))), addHours(utcNow(),48))",
                  "item/FirstResponseDueDate": "@if(greater(length(outputs(\u0027Get_SLA_bySeverity\u0027)?[\u0027body/value\u0027]),0), addHours(utcNow(), int(coalesce(first(outputs(\u0027Get_SLA_bySeverity\u0027)?[\u0027body/value\u0027])?[\u0027FirstResponseHours\u0027],\u00278\u0027))), addHours(utcNow(),8))"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "PatchItem",
                  "connectionName": "shared_sharepointonline"
                }
              },
              "runAfter": {
                "Get_SLA_bySeverity": [
                  "Succeeded"
                ]
              }
            },
            "Send_email_team": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "emailMessage/To": "@variables(\u0027MailToFinal\u0027)",
                  "emailMessage/Subject": "[AI Helpdesk] \u0E40\u0E04\u0E2A\u0E43\u0E2B\u0E21\u0E48 @{variables(\u0027CaseID\u0027)} - @{triggerBody()?[\u0027text_4\u0027]}",
                  "emailMessage/Body": "\u003Cp\u003E\u0E40\u0E23\u0E35\u0E22\u0E19\u0E40\u0E08\u0E49\u0E32\u0E2B\u0E19\u0E49\u0E32\u0E17\u0E35\u0E48\u003C/p\u003E\u003Cp\u003ECaseID: @{variables(\u0027CaseID\u0027)}\u003Cbr\u003E\u0E23\u0E30\u0E1A\u0E1A: @{triggerBody()?[\u0027text_4\u0027]}\u003Cbr\u003E\u0E1B\u0E23\u0E30\u0E40\u0E20\u0E17: @{variables(\u0027CaseType\u0027)}\u003Cbr\u003E\u0E04\u0E27\u0E32\u0E21\u0E40\u0E23\u0E48\u0E07\u0E14\u0E48\u0E27\u0E19: @{variables(\u0027Priority\u0027)} (@{variables(\u0027Severity\u0027)})\u003C/p\u003E\u003Cp\u003E\u0E23\u0E32\u0E22\u0E25\u0E30\u0E40\u0E2D\u0E35\u0E22\u0E14: @{triggerBody()?[\u0027text_5\u0027]}\u003C/p\u003E\u003Cp\u003E\u0E1C\u0E39\u0E49\u0E41\u0E08\u0E49\u0E07: @{triggerBody()?[\u0027text_2\u0027]} - @{triggerBody()?[\u0027text_3\u0027]} - @{triggerBody()?[\u0027text_1\u0027]}\u003C/p\u003E\u003Chr\u003E\u0E23\u0E30\u0E1A\u0E1A AI Helpdesk",
                  "emailMessage/Cc": "@variables(\u0027MailCC\u0027)",
                  "emailMessage/Importance": "Normal"
                },
                "host": {
