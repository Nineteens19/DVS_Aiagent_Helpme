                  "item/Priority/Value": "@variables(\u0027Priority\u0027)",
                  "item/Severity/Value": "@variables(\u0027Severity\u0027)",
                  "item/ProblemDetail": "@triggerBody()?[\u0027text_5\u0027]",
                  "item/IssueSummary": "@concat(coalesce(triggerBody()?[\u0027text\u0027],\u0027\u0027),\u0027 - \u0027,coalesce(triggerBody()?[\u0027text_4\u0027],\u0027\u0027))",
                  "item/Username": "@if(and(not(equals(coalesce(triggerBody()?[\u0027text_6\u0027],\u0027\u0027),\u0027\u0027)), not(equals(triggerBody()?[\u0027text_6\u0027],\u0027-\u0027))), triggerBody()?[\u0027text_6\u0027], coalesce(outputs(\u0027Get_user_profile\u0027)?[\u0027body/userPrincipalName\u0027], \u0027\u0027))",
                  "item/ReporterName": "@coalesce(outputs(\u0027Get_user_profile\u0027)?[\u0027body/displayName\u0027], if(equals(coalesce(triggerBody()?[\u0027text_2\u0027],\u0027\u0027),\u0027-\u0027),\u0027\u0027,triggerBody()?[\u0027text_2\u0027]), triggerBody()?[\u0027text_1\u0027], \u0027User\u0027)",
