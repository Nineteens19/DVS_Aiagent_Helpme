            "Create_item_Cases": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "https://dvsins.sharepoint.com/sites/PowerAppPRD",
                  "table": "b8b22b0d-45c6-43c9-bc66-06e5e45b1237",
                  "item/CaseType/Value": "@variables(\u0027CaseType\u0027)",
