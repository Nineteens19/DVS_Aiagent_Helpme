                  "item/ReporterTel": "@if(and(not(equals(coalesce(triggerBody()?[\u0027text_3\u0027],\u0027\u0027),\u0027\u0027)), not(equals(triggerBody()?[\u0027text_3\u0027],\u0027-\u0027))), triggerBody()?[\u0027text_3\u0027], coalesce(outputs(\u0027Get_user_profile\u0027)?[\u0027body/mobilePhone\u0027], first(outputs(\u0027Get_user_profile\u0027)?[\u0027body/businessPhones\u0027]), \u0027-\u0027))",
                  "item/Statuscase/Value": "Open"
